{
  "name": "snout",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true,
    "protobufjs": true,
    "@firebase/util": true,
    "@google/genai": true
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "NODE_ENV=production tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "lint:rules": "eslint firestore.rules",
    "admin:promote": "tsx deploy/promote-admin.ts",
    "admin:provision": "tsx deploy/provision-admin.ts",
    "desktop": "electron .",
    "desktop:dist": "npm run build && electron-builder --win nsis --linux AppImage deb",
    "desktop:win": "npm run build && electron-builder --win nsis",
    "desktop:linux": "npm run build && electron-builder --linux AppImage deb",
    "desktop:rust:dev": "cd src-tauri && cargo tauri dev",
    "desktop:rust:linux": "npm run build && cd src-tauri && cargo tauri build --bundles appimage",
    "desktop:rust:windows": "npm run build && cd src-tauri && cargo tauri build --bundles nsis",
    "test": "vitest run"
  },
  "build": {
    "appId": "cloud.snout.desktop",
    "productName": "Snout",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network;InstantMessaging"
    }
  },
  "dependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "eslint": "^10.15.0",
    "express": "^4.21.2",
    "firebase": "^13.3.0",
    "firebase-admin": "^14.5.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "uuid": "^14.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.1.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.2.0"
  }
}
